{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fluent-menu",
  "version": "0.1.0",
  "identifier": "dev.t21.fluentmenu",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "fluent-menu",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "decorations": true,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "TriptoAfsin",
    "shortDescription": "Modern Windows context menu manager",
    "longDescription": "Create, edit, enable and remove Windows Explorer context menu entries, with Nilesoft Shell support.",
    "category": "Utility",
    "copyright": "Copyright (c) 2026 TriptoAfsin",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
